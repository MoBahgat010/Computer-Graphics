            "samplers": {
                "default": {}
            },
            "materials": {
              "main-map": {
                "type": "textured",
                "shader": "textured",
                "pipelineState": {
                  "faceCulling": {
                    "enabled": false
                  },
                  "depthTesting": {
                    "enabled": true
                  }
                },
                "tint": [1, 1, 1, 1],
                "texture": "grass",
                "sampler": "default"
              },
