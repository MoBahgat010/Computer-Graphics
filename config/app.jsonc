                "point":       { "vs": "assets/shaders/light/light.vert", "fs": "assets/shaders/light/point.frag" },
                "spot":        { "vs": "assets/shaders/light/light.vert", "fs": "assets/shaders/light/spot.frag" }
            },
            "textures": {
                "fallback": "assets/textures/grass_ground_d.jpg"
            },
            "meshes": {
                "cube":           "assets/models/cube.obj",
                "monkey":         "assets/models/monkey.obj",
